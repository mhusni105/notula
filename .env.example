# AI Provider Configuration
# -------------------------
# AI_PROVIDER: Pilih provider AI. Opsi: gemini (default), openai, 9router, anthropic
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Diperlukan jika AI_PROVIDER=gemini. Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OPENAI_API_KEY: Diperlukan jika AI_PROVIDER=openai atau 9router. Dapatkan di https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Diperlukan jika AI_PROVIDER=anthropic. Dapatkan di https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# AI_BASE_URL: Kustom base URL (wajib untuk 9router, opsional untuk openai).
# Contoh 9router: https://api.9router.com/v1
# Contoh OpenAI: https://api.openai.com/v1 (default)
AI_BASE_URL=""

# AI_MODEL_STT: Override model STT (default: tergantung provider)
#   Gemini: gemini-3.5-flash
#   OpenAI/9router: whisper-1
AI_MODEL_STT=""

# AI_MODEL_LLM: Override model LLM (default: tergantung provider)
#   Gemini: gemini-3.5-flash
#   OpenAI: gpt-4o-mini
#   9router: gpt-4o-mini
#   Anthropic: claude-3-5-haiku-latest
AI_MODEL_LLM=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_STT_ENDPOINT: Full URL untuk STT (audio-to-text) API. Jika kosong, otomatis 
# menggunakan {AI_BASE_URL}/audio/transcriptions.
# Berguna jika proxy/router (seperti 9router) memiliki endpoint STT yang berbeda.
# Contoh: https://api.9router.com/v1/audio/transcriptions
AI_STT_ENDPOINT=""
