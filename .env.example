# AI Provider Configuration
# -------------------------
# AI_PROVIDER: Pilih provider AI. Opsi: gemini (default), openai, anthropic
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Diperlukan jika AI_PROVIDER=gemini. Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# OPENAI_API_KEY: Diperlukan jika AI_PROVIDER=openai. Dapatkan di https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Diperlukan jika AI_PROVIDER=anthropic. Dapatkan di https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# AI_BASE_URL: Kustom base URL (opsional).
# Contoh OpenAI: https://api.openai.com/v1 (default)
AI_BASE_URL=""

# AI_MODEL_STT: Override model STT (default: tergantung provider)
#   Gemini: gemini-3.5-flash
#   OpenAI: whisper-1
AI_MODEL_STT=""

# AI_MODEL_LLM: Override model LLM (default: tergantung provider)
#   Gemini: gemini-3.5-flash
#   OpenAI: gpt-4o-mini
#   Anthropic: claude-3-5-haiku-latest
AI_MODEL_LLM=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_STT_ENDPOINT: Full URL untuk STT (audio-to-text) API. Jika kosong, otomatis 
# menggunakan {AI_BASE_URL}/audio/transcriptions.
AI_STT_ENDPOINT=""

# Whisper Local STT Configuration
# -------------------------------
# WHISPER_MODEL: Ukuran model. Opsi: tiny, base (default), small, medium, large, turbo
#   - tiny:   ~1 GB VRAM, cepat, kurang akurat
#   - base:   ~1 GB VRAM, recommended (default)
#   - small:  ~2 GB VRAM, akurat
#   - medium: ~5 GB VRAM, sangat akurat
#   - large:  ~10 GB VRAM, paling akurat
#   - turbo:  ~6 GB VRAM, optimized
WHISPER_MODEL="base"

# WHISPER_PORT: Port untuk local Whisper server (default: 9090)
WHISPER_PORT="9090"

# WHISPER_LANGUAGE: Kode bahasa untuk transkripsi (default: id)
# Gunakan kode bahasa ISO 639-1 (id, en, ja, dll.)
# Biarkan kosong untuk auto-detect.
WHISPER_LANGUAGE="id"

# WHISPER_DEVICE: Perangkat untuk menjalankan model (default: cpu)
# Gunakan "cuda" jika memiliki GPU NVIDIA dengan CUDA.
WHISPER_DEVICE="cpu"

# Google OAuth 2.0 Configuration
# Diperlukan untuk fitur Login dengan Google dan integrasi Google Drive.
# Dapatkan credential di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

